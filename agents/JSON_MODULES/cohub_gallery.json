        "version": 1,
        "label": "Handoff Team (고객 서비스)",
        "description": "에이전트가 작업 요구사항에 따라 다른 에이전트에게 동적으로 제어권을 이전합니다. 각 에이전트가 언제, 누구에게 위임할지 결정하여 유연한 워크플로우 전환을 가능하게 합니다.",
        "config": {
          "participants": [
            {
              "provider": "autogen_agentchat.agents.AssistantAgent",
              "component_type": "agent",
              "config": {
                "name": "triage_agent",
                "description": "고객 문의 분류",
                "reflect_on_tool_use": false,
                "tool_call_summary_format": "{result}",
