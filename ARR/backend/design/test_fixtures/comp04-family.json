          "spatial_strategy": "\ub4a4 \uc5c5\ubb34\uc9d1 \ud55c \ucc44\uc640 \uc55e \uc8fc\ubbfc\uc9d1\u00b7\ubaa8\uc784\uc9d1 \ub450 \ucc44\uac00 \ubaa8\ub4e0 \ub192\uc774\uc5d0\uc11c \ubd84\ub9ac\ub41c\ub2e4. \ub4a4 \uc9d1\uc740 \ub192\uc774 10.8m\uc758 \ucd5c\ub300 3\uce35, \uc55e \ub450 \uc9d1\uc740 \uac01\uac01 6.912m\uc758 2\uce35 \uad6c\uc0c1\uc774\uba70 \uc790\uccb4 \uce35\uace0\ub294 3.6m\ub2e4. \ub450 \uc55e\uc9d1 \uc0ac\uc774\uc758 \ud2c8\uc774 \ub4a4 \uc9d1 \uc55e \uacf5\ud1b5\ub9c8\ub2f9\uc73c\ub85c \uc774\uc5b4\uc838 \uac01 \uc9d1\uc758 \ub3c5\ub9bd \ucd9c\uc785 \uac00\ub2a5\uc131\uc744 \ub9cc\ub4e0\ub2e4.",
          "tradeoff": "\uc138 \uc9d1\uc758 \ucd9c\uc785\ubb38\u00b7\uacc4\ub2e8\u00b7\uc2b9\uac15\uae30\uc640 \uc6b0\ucc9c \uc2dc \uc774\ub3d9\uc740 \ubbf8\uc815\uc774\ub2e4. \uc55e\uc9d1 \uc0c1\uce35\uc758 \ubc14\ub2e5\u00b7\ubcf4\u00b7\uc124\ube44 \ub450\uaed8\ub97c \ud3ec\ud568\ud55c \uc2e4\uc81c \uc720\ud6a8\ub192\uc774\ub97c \ub354 \uac80\uc99d\ud574\uc57c \ud55c\ub2e4. \ud070 \uacf5\ud1b5\ub9c8\ub2f9\uc740 \uc644\uc804\ud788 \ub2eb\ud78c \uc911\uc815\uc774 \uc544\ub2c8\ub77c \uc5ec\ub7ec \ud2c8\uc73c\ub85c \uc774\uc5b4\uc9c4 \uc678\ubd80\uacf5\uac04\uc774\ub2e4."
        }
      }
    ]
  }
