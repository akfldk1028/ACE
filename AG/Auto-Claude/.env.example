# AG/Auto-Claude CLI Configuration

# Auto-Claude Backend Path (relative to project root)
AUTO_CLAUDE_PATH=./apps/backend

# SharedMemory (AG-CLI)
SHARED_MEMORY_URL=http://localhost:8101
ENABLE_SHARED_MEMORY=true

# Pipeline Settings
MAX_QA_ITERATIONS=5
STAGE_TIMEOUT_SECONDS=300

# Orchestrator
ORCHESTRATOR_POLL_INTERVAL=1.0
ORCHESTRATOR_BATCH_SIZE=1

# AG Connections
AG_AUTOGEN_URL=http://localhost:8000
AG_LAW_DOMAIN_URL=http://localhost:8001
ADAPTER_TIMEOUT=120.0

# Neo4j (optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Task Queue
QUEUE_DB_PATH=./data/tasks.db
QUEUE_MAX_RETRIES=3

# Projects
PROJECTS_DIR=./projects

# Logging
BRIDGE_LOG_LEVEL=INFO
